generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECCION
  GERENTE
  MEJORA_CONTINUA
  SUPERVISOR
  CALIDAD
  SEGURIDAD
  MANTENIMIENTO
  COLABORADOR
}

enum IdeaStatus {
  REGISTRADA
  EN_REVISION_SUPERVISOR
  RECHAZADA_SUPERVISOR
  SOLICITUD_INFORMACION
  APROBADA_SUPERVISOR
  EN_VALIDACION_CALIDAD
  EN_VALIDACION_SEGURIDAD
  EN_VALIDACION_MANTENIMIENTO
  RECHAZADA_VALIDACION
  APROBADA_PARA_IMPLEMENTAR
  CLASIFICACION_MEJORA_CONTINUA
  EN_IMPLEMENTACION
  IMPLEMENTADA
  EN_VALIDACION_FINAL
  CERRADA
  CANCELADA
  VENCIDA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum IdeaCategory {
  A
  B
  C
}

enum Classification {
  IDEA_RAPIDA
  ACCION_MANTENIMIENTO
  KAIZEN
  PROYECTO_DMAIC
  PLAN_ACCION
  CINCO_S_GESTION_VISUAL
  SEGURIDAD
  CALIDAD_INOCUIDAD
  NO_VIABLE
}

enum ApprovalType {
  SUPERVISOR
  CALIDAD
  SEGURIDAD
  MANTENIMIENTO
  MEJORA_CONTINUA_FINAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO
}

enum ApprovalDecision {
  APROBAR
  RECHAZAR
  SOLICITAR_INFORMACION
}

enum AttachmentType {
  BEFORE
  AFTER
  OTHER
}

enum NotificationChannel {
  EMAIL
  TEAMS
  LOCAL
}

enum NotificationStatus {
  PENDING
  SENT
  ERROR
  DISMISSED
}

enum NotificationAudience {
  OPERATIONAL
  EXECUTIVE_VALIDATION
}

enum ExecutiveValidationLevel {
  DIRECTOR
  CEO
}

enum ExecutiveValidationStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO
  CANCELLED
}

enum KaizenStatus {
  PENDIENTE_CHARTER
  PLANIFICACION
  EN_CURSO
  EN_PAUSA
  COMPLETADO
  CANCELADO
}

enum WorkItemStatus {
  PENDIENTE
  EN_PROCESO
  BLOQUEADA
  COMPLETADA
  CANCELADA
  COMBINADA
}

enum GenbaStatus {
  ABIERTO
  CERRADO
  CANCELADO
}

enum KaizenAttachmentType {
  CHARTER
  EVIDENCE
  OTHER
}

enum GenbaAttachmentType {
  EVIDENCE
  OTHER
}

enum OrgUnitType {
  MACROPROCESO
  DEPARTAMENTO
  AREA
  PROCESO
}

enum TrainingEnrollmentStatus {
  REGISTERED
  COMPLETED
  CANCELLED
}

enum PayrollFrequency {
  UNCLASSIFIED
  WEEKLY
  BIWEEKLY
}

enum ParticipantEmailStatus {
  UNCHECKED
  FOUND
  PENDING
  NOT_APPLICABLE
}

enum CoinTransactionType {
  AWARD
  ADJUSTMENT
  REDEMPTION
}

enum CoinSourceType {
  IDEA
  KAIZEN
  GENBA
  TRAINING
  MANUAL
}

model User {
  id                            String                @id @default(cuid())
  name                          String
  email                         String                @unique
  role                          Role
  passwordHash                  String
  active                        Boolean               @default(true)
  kaizenAccess                  Boolean               @default(false)
  genbaAccess                   Boolean               @default(false)
  jobTitle                      String?
  employeeNumber                String?               @unique
  // Obliga a poner contrasena propia antes de usar el sistema. Se enciende cuando la
  // contrasena la puso alguien mas: el alta inicial o un administrador.
  mustChangePassword            Boolean               @default(false)
  // Con que abre cada quien su bandeja. Nulo = el comportamiento de siempre.
  followUpView                  String?
  followUpModule                String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  supervisedAreas               Area[]                @relation("AreaSupervisor")
  supervisedIdeas               Idea[]                @relation("IdeaSupervisor")
  ownedImplementations          Idea[]                @relation("ImplementationOwner")
  approvals                     Approval[]
  comments                      Comment[]
  auditLogs                     AuditLog[]
  ledKaizenProjects             KaizenProject[]       @relation("KaizenLeader")
  createdKaizenProjects         KaizenProject[]       @relation("KaizenCreator")
  closedKaizenProjects          KaizenProject[]       @relation("KaizenCloser")
  kaizenTeamMemberships         KaizenTeamMember[]    @relation("KaizenTeamMemberUser")
  ownedKaizenActivities         KaizenActivity[]      @relation("KaizenActivityOwner")
  kaizenUpdates                 KaizenUpdate[]
  coordinatedGenbaWalks         GenbaWalk[]           @relation("GenbaCoordinator")
  createdGenbaWalks             GenbaWalk[]           @relation("GenbaCreator")
  ownedGenbaActivities          GenbaActivity[]       @relation("GenbaActivityOwner")
  genbaUpdates                  GenbaUpdate[]
  routedOrgUnits                OrgUnit[]             @relation("OrgUnitRoutingUser")
  orgMemberships                OrgMembership[]
  assignedSupportIdeas          IdeaSupportRequest[]  @relation("IdeaSupportAssignee")
  followedIdeas                 IdeaFollower[]        @relation("IdeaFollowerUser")
  followedKaizen                KaizenFollower[]      @relation("KaizenFollowerUser")
  followedGenba                 GenbaFollower[]       @relation("GenbaFollowerUser")
  createdIdeaFollowers          IdeaFollower[]        @relation("IdeaFollowerCreator")
  participant                   Participant?
  createdTrainingPrograms       TrainingProgram[]     @relation("TrainingProgramCreator")
  createdTrainingSessions       TrainingSession[]     @relation("TrainingSessionCreator")
  createdCoinTransactions       CoinTransaction[]     @relation("CoinTransactionCreator")
  requestedExecutiveValidations ExecutiveValidation[] @relation("ExecutiveValidationRequester")
  assignedExecutiveValidations  ExecutiveValidation[] @relation("ExecutiveValidationAssignee")

  @@index([active, name])
  @@index([role, active])
}

model Area {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  supervisorId     String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  supervisor       User?    @relation("AreaSupervisor", fields: [supervisorId], references: [id])
  ideas            Idea[]
  organizationUnit OrgUnit? @relation("OrgUnitCaptureArea")
}

model Plant {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orgUnits         OrgUnit[]
  trainingSessions TrainingSession[]
}

model OrgUnit {
  id               String               @id @default(cuid())
  plantId          String
  parentId         String?
  type             OrgUnitType
  code             String               @unique
  name             String
  responsible      String
  manager          String
  routingUserId    String?
  captureAreaId    String?              @unique
  qrEnabled        Boolean              @default(false)
  isSupportArea    Boolean              @default(false)
  active           Boolean              @default(true)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  plant            Plant                @relation(fields: [plantId], references: [id], onDelete: Cascade)
  parent           OrgUnit?             @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         OrgUnit[]            @relation("OrgUnitTree")
  routingUser      User?                @relation("OrgUnitRoutingUser", fields: [routingUserId], references: [id], onDelete: SetNull)
  captureArea      Area?                @relation("OrgUnitCaptureArea", fields: [captureAreaId], references: [id], onDelete: SetNull)
  memberships      OrgMembership[]
  escalationRules  OrgEscalationRule[]
  supportRequests  IdeaSupportRequest[]
  participants     Participant[]
  trainingSessions TrainingSession[]
  kaizenProjects   KaizenProject[]
  genbaWalks       GenbaWalk[]

  @@index([plantId, parentId, sortOrder])
}

model Idea {
  id                      String                @id @default(cuid())
  folio                   String                @unique
  collaboratorName        String
  collaboratorEmail       String?
  employeeNumber          String?
  areaId                  String
  shift                   String
  problem                 String
  proposal                String
  expectedBenefit         String
  impactTypes             String
  category                IdeaCategory          @default(A)
  impactsQuality          Boolean               @default(false)
  impactsSafety           Boolean               @default(false)
  requiresMaintenance     Boolean               @default(false)
  requiresExternalSupport Boolean               @default(false)
  externalSupportDetails  String?
  priority                Priority?
  classification          Classification?
  status                  IdeaStatus            @default(EN_REVISION_SUPERVISOR)
  supervisorId            String?
  implementationOwnerId   String?
  dueDate                 DateTime?
  requiresEvidence        Boolean               @default(true)
  implementedAt           DateTime?
  closedAt                DateTime?
  pointsAssigned          Int                   @default(0)
  rejectionReason         String?
  moreInfoRequest         String?
  mcComments              String?
  escalationRuleId        String?
  submitterPosition       String?
  participantId           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  area                    Area                  @relation(fields: [areaId], references: [id])
  supervisor              User?                 @relation("IdeaSupervisor", fields: [supervisorId], references: [id])
  implementationOwner     User?                 @relation("ImplementationOwner", fields: [implementationOwnerId], references: [id])
  approvals               Approval[]
  attachments             Attachment[]
  comments                Comment[]
  pointRuleSelections     IdeaPointRule[]
  notifications           NotificationOutbox[]
  kaizenProject           KaizenProject?
  escalationRule          OrgEscalationRule?    @relation(fields: [escalationRuleId], references: [id], onDelete: SetNull)
  participant             Participant?          @relation(fields: [participantId], references: [id], onDelete: SetNull)
  supportRequests         IdeaSupportRequest[]
  followers               IdeaFollower[]
  executiveValidations    ExecutiveValidation[]

  @@index([status, createdAt])
  @@index([areaId, createdAt])
  @@index([supervisorId, status])
}

model OrgMembership {
  id                    String              @id @default(cuid())
  userId                String
  orgUnitId             String
  title                 String
  level                 Int                 @default(0)
  managerMembershipId   String?
  canReviewTeam         Boolean             @default(false)
  canReceiveIdeas       Boolean             @default(false)
  canManageActivities   Boolean             @default(false)
  active                Boolean             @default(true)
  sortOrder             Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit               OrgUnit             @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  managerMembership     OrgMembership?      @relation("OrgMembershipManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  directReports         OrgMembership[]     @relation("OrgMembershipManager")
  escalationAssignments OrgEscalationRule[] @relation("EscalationReviewer")

  @@unique([userId, orgUnitId])
  @@index([orgUnitId, level, active])
  @@index([managerMembershipId])
}

model OrgEscalationRule {
  id                   String        @id @default(cuid())
  orgUnitId            String
  name                 String
  submitterLabel       String
  circumstance         String?
  submitterLevel       Int           @default(0)
  reviewerMembershipId String
  isDefault            Boolean       @default(false)
  active               Boolean       @default(true)
  sortOrder            Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  orgUnit              OrgUnit       @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  reviewerMembership   OrgMembership @relation("EscalationReviewer", fields: [reviewerMembershipId], references: [id], onDelete: Cascade)
  ideas                Idea[]

  @@index([orgUnitId, active, sortOrder])
}

model IdeaSupportRequest {
  id           String            @id @default(cuid())
  ideaId       String
  orgUnitId    String
  assignedToId String?
  status       ApprovalStatus    @default(PENDING)
  decision     ApprovalDecision?
  comments     String?
  decidedAt    DateTime?
  activatedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  idea         Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  orgUnit      OrgUnit           @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  assignedTo   User?             @relation("IdeaSupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([ideaId, orgUnitId])
  @@index([assignedToId, status])
}

model IdeaFollower {
  id          String   @id @default(cuid())
  ideaId      String
  userId      String
  createdById String?
  label       String   @default("Seguimiento")
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user        User     @relation("IdeaFollowerUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("IdeaFollowerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([ideaId, userId])
  @@index([userId])
}

model Participant {
  id               String                 @id @default(cuid())
  userId           String?                @unique
  orgUnitId        String?
  name             String
  employeeNumber   String?                @unique
  email            String?
  jobTitle         String?
  payrollFrequency PayrollFrequency       @default(UNCLASSIFIED)
  emailStatus      ParticipantEmailStatus @default(UNCHECKED)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgUnit          OrgUnit?               @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  ideas            Idea[]
  enrollments      TrainingEnrollment[]
  coinTransactions CoinTransaction[]
  genbaAttendances GenbaAttendee[]

  @@index([name])
  @@index([active, name])
  @@index([email])
  @@index([orgUnitId, active])
  @@index([payrollFrequency, active])
  @@index([emailStatus, active])
}

model TrainingProgram {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  coinValue   Int
  active      Boolean           @default(true)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   User              @relation("TrainingProgramCreator", fields: [createdById], references: [id])
  sessions    TrainingSession[]
}

model TrainingSession {
  id          String               @id @default(cuid())
  programId   String
  plantId     String?
  orgUnitId   String?
  sessionDate DateTime
  trainerName String?
  notes       String?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  program     TrainingProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  plant       Plant?               @relation(fields: [plantId], references: [id], onDelete: SetNull)
  orgUnit     OrgUnit?             @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("TrainingSessionCreator", fields: [createdById], references: [id])
  enrollments TrainingEnrollment[]

  @@index([sessionDate])
}

model TrainingEnrollment {
  id            String                   @id @default(cuid())
  sessionId     String
  participantId String
  status        TrainingEnrollmentStatus @default(REGISTERED)
  coinsAwarded  Int                      @default(0)
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  session       TrainingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant   Participant              @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([sessionId, participantId])
  @@index([sessionId, status])
  @@index([participantId, status])
}

model CoinTransaction {
  id               String              @id @default(cuid())
  reference        String              @unique
  participantId    String
  type             CoinTransactionType
  sourceType       CoinSourceType
  sourceId         String?
  amount           Int
  description      String
  correctionReason String?
  reversalOfId     String?             @unique
  createdById      String?
  occurredAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  participant      Participant         @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdBy        User?               @relation("CoinTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reversalOf       CoinTransaction?    @relation("CoinTransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal         CoinTransaction?    @relation("CoinTransactionReversal")

  @@index([participantId, occurredAt])
  @@index([sourceType, sourceId])
  @@index([sourceType, occurredAt])
  @@index([type, occurredAt])
  @@index([reversalOfId])
  @@index([occurredAt, createdAt])
}

model Approval {
  id           String            @id @default(cuid())
  ideaId       String
  type         ApprovalType
  assignedToId String?
  status       ApprovalStatus    @default(PENDING)
  decision     ApprovalDecision?
  comments     String?
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  idea         Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  assignedTo   User?             @relation(fields: [assignedToId], references: [id])

  @@unique([ideaId, type])
}

model Attachment {
  id         String         @id @default(cuid())
  ideaId     String
  type       AttachmentType
  filename   String
  path       String
  uploadedBy String?
  createdAt  DateTime       @default(now())
  idea       Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String?
  comment   String
  createdAt DateTime @default(now())
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model PointRule {
  id          String          @id @default(cuid())
  name        String
  description String
  points      Int
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  ideas       IdeaPointRule[]
}

model IdeaPointRule {
  id          String    @id @default(cuid())
  ideaId      String
  pointRuleId String
  points      Int
  createdAt   DateTime  @default(now())
  idea        Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  pointRule   PointRule @relation(fields: [pointRuleId], references: [id])

  @@unique([ideaId, pointRuleId])
}

model ExecutiveValidation {
  id                 String                    @id @default(cuid())
  ideaId             String
  requestedById      String
  assignedToId       String
  level              ExecutiveValidationLevel
  status             ExecutiveValidationStatus @default(PENDING)
  requestNote        String
  decisionComment    String?
  cancellationReason String?
  decidedAt          DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  idea               Idea                      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  requestedBy        User                      @relation("ExecutiveValidationRequester", fields: [requestedById], references: [id])
  assignedTo         User                      @relation("ExecutiveValidationAssignee", fields: [assignedToId], references: [id])

  @@index([ideaId, status])
  @@index([assignedToId, status])
  @@index([requestedById, status])
}

model NotificationOutbox {
  id           String               @id @default(cuid())
  ideaId       String?
  channel      NotificationChannel
  audience     NotificationAudience @default(OPERATIONAL)
  to           String
  subject      String
  body         String
  status       NotificationStatus   @default(PENDING)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime             @default(now())
  idea         Idea?                @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([audience, status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  details   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model KaizenProject {
  followers        KaizenFollower[]
  id               String             @id @default(cuid())
  number           Int                @unique
  folio            String             @unique
  title            String
  plant            String?
  area             String
  objective        String
  scope            String?
  baselineValue    Float?
  targetValue      Float?
  currentValue     Float?
  unit             String?
  estimatedSavings Float?
  realSavings      Float?
  status           KaizenStatus       @default(PENDIENTE_CHARTER)
  startDate        DateTime
  endDate          DateTime
  /// Cierre comprometido antes de reagendar. El Excel lo dibuja como el tramo "Original"
  /// de la barra; lo que sigue en color "Reagenda" es el corrimiento. Guardarlo aparte es
  /// lo unico que permite decir cuantos dias se recorrio un Kaizen, porque endDate ya trae
  /// la fecha nueva y por si sola no delata que hubo un cambio.
  originalEndDate  DateTime?
  closedAt         DateTime?
  closureNote      String?
  closedById       String?
  leaderId         String
  createdById      String
  sourceIdeaId     String?            @unique
  orgUnitId        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  leader           User               @relation("KaizenLeader", fields: [leaderId], references: [id])
  createdBy        User               @relation("KaizenCreator", fields: [createdById], references: [id])
  closedBy         User?              @relation("KaizenCloser", fields: [closedById], references: [id], onDelete: SetNull)
  sourceIdea       Idea?              @relation(fields: [sourceIdeaId], references: [id], onDelete: SetNull)
  orgUnit          OrgUnit?           @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  activities       KaizenActivity[]
  teamMembers      KaizenTeamMember[]
  attachments      KaizenAttachment[]
  updates          KaizenUpdate[]

  @@index([status, closedAt])
}

model KaizenTeamMember {
  id              String        @id @default(cuid())
  projectId       String
  userId          String
  role            String        @default("Miembro")
  rewardAmount    Int?
  rewardReason    String?
  rewardDecidedAt DateTime?
  createdAt       DateTime      @default(now())
  project         KaizenProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User          @relation("KaizenTeamMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
}

model KaizenActivity {
  id                    String             @id @default(cuid())
  projectId             String
  number                Int
  problem               String?
  action                String
  ownerId               String?
  startDate             DateTime?
  dueDate               DateTime?
  status                WorkItemStatus     @default(PENDIENTE)
  completionNote        String?
  cancellationReason    String?
  closedAt              DateTime?
  mergedIntoId          String?
  mergeReason           String?
  sourceGenbaActivityId String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  project               KaizenProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner                 User?              @relation("KaizenActivityOwner", fields: [ownerId], references: [id])
  mergedInto            KaizenActivity?    @relation("KaizenActivityMerge", fields: [mergedIntoId], references: [id])
  mergedActivities      KaizenActivity[]   @relation("KaizenActivityMerge")
  sourceGenbaActivity   GenbaActivity?     @relation("GenbaPromotion", fields: [sourceGenbaActivityId], references: [id], onDelete: SetNull)
  attachments           KaizenAttachment[]
  updates               KaizenUpdate[]

  @@unique([projectId, number])
}

model KaizenAttachment {
  id         String               @id @default(cuid())
  projectId  String
  activityId String?
  type       KaizenAttachmentType
  filename   String
  path       String
  uploadedBy String
  createdAt  DateTime             @default(now())
  project    KaizenProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity   KaizenActivity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model KaizenUpdate {
  id         String          @id @default(cuid())
  projectId  String
  activityId String?
  userId     String?
  comment    String
  createdAt  DateTime        @default(now())
  project    KaizenProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity   KaizenActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id])
}

model GenbaWalk {
  followers           GenbaFollower[]
  id                  String            @id @default(cuid())
  number              Int               @unique
  folio               String            @unique
  areaName            String
  visitDate           DateTime
  expectedDepartments String
  attendedDepartments String
  notes               String?
  status              GenbaStatus       @default(ABIERTO)
  coordinatorId       String
  createdById         String
  orgUnitId           String?
  closedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  coordinator         User              @relation("GenbaCoordinator", fields: [coordinatorId], references: [id])
  createdBy           User              @relation("GenbaCreator", fields: [createdById], references: [id])
  orgUnit             OrgUnit?          @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  activities          GenbaActivity[]
  attachments         GenbaAttachment[]
  updates             GenbaUpdate[]
  attendees           GenbaAttendee[]
}

model GenbaAttendee {
  id            String      @id @default(cuid())
  walkId        String
  participantId String
  createdAt     DateTime    @default(now())
  walk          GenbaWalk   @relation(fields: [walkId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([walkId, participantId])
  @@index([participantId])
}

model GenbaActivity {
  id                     String            @id @default(cuid())
  walkId                 String
  number                 Int
  problem                String
  action                 String?
  ownerId                String?
  dueDate                DateTime?
  status                 WorkItemStatus    @default(PENDIENTE)
  completionNote         String?
  cancellationReason     String?
  closedAt               DateTime?
  mergedIntoId           String?
  mergeReason            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  walk                   GenbaWalk         @relation(fields: [walkId], references: [id], onDelete: Cascade)
  owner                  User?             @relation("GenbaActivityOwner", fields: [ownerId], references: [id])
  mergedInto             GenbaActivity?    @relation("GenbaActivityMerge", fields: [mergedIntoId], references: [id])
  mergedActivities       GenbaActivity[]   @relation("GenbaActivityMerge")
  promotedKaizenActivity KaizenActivity?   @relation("GenbaPromotion")
  attachments            GenbaAttachment[]
  updates                GenbaUpdate[]

  @@unique([walkId, number])
}

model GenbaAttachment {
  id         String              @id @default(cuid())
  walkId     String
  activityId String?
  type       GenbaAttachmentType @default(EVIDENCE)
  filename   String
  path       String
  uploadedBy String
  createdAt  DateTime            @default(now())
  walk       GenbaWalk           @relation(fields: [walkId], references: [id], onDelete: Cascade)
  activity   GenbaActivity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model GenbaUpdate {
  id         String         @id @default(cuid())
  walkId     String
  activityId String?
  userId     String?
  comment    String
  createdAt  DateTime       @default(now())
  walk       GenbaWalk      @relation(fields: [walkId], references: [id], onDelete: Cascade)
  activity   GenbaActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User?          @relation(fields: [userId], references: [id])
}

/// Seguimiento que una persona decide por su cuenta, no uno que le asignaron.
///
/// IdeaFollower ya existia, pero solo para Ideas y solo un administrador podia crearlo.
/// Estos dos lo extienden a Kaizen y GENBA y se crean por decision de quien sigue. Son
/// tablas propias en vez de una sola tabla generica con un id suelto porque asi la llave
/// foranea existe de verdad: si el proyecto se borra, el seguimiento se va con el y no
/// queda apuntando a la nada.
model KaizenFollower {
  id        String        @id @default(cuid())
  projectId String
  userId    String
  label     String        @default("Seguimiento propio")
  pinned    Boolean       @default(false)
  createdAt DateTime      @default(now())
  project   KaizenProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User          @relation("KaizenFollowerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model GenbaFollower {
  id        String    @id @default(cuid())
  walkId    String
  userId    String
  label     String    @default("Seguimiento propio")
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  walk      GenbaWalk @relation(fields: [walkId], references: [id], onDelete: Cascade)
  user      User      @relation("GenbaFollowerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([walkId, userId])
  @@index([userId])
}
