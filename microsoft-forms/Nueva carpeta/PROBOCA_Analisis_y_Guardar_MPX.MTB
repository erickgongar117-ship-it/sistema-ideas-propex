# PROBOCA - Analisis estadistico de produccion diaria por linea
# Fuente: Planeacion Cumplimiento programa 2025 y 2026
# IMPORTANTE: Abra primero PROBOCA_Minitab_IMR_Wide.csv en Minitab y deje esa hoja activa.
# Se excluyen dias sin produccion registrada para el I-MR; cada columna contiene solo dias operados.

NOTE "===== P1 MUSLO ====="
DESCRIBE C2;
 MEAN;
 STDEV;
 CVARIATION;
 MEDIAN;
 MIN;
 MAX.
LET K1 = PERCENTILE(C2,0.90)
LET K2 = PERCENTILE(C2,0.95)
NOTE "P90 y P95 (kg/dia) para P1 MUSLO:"
WRITE K1 K2
NORMTEST C2;
 TITLE "P1 MUSLO - Normalidad (Produccion diaria)".
IMRCHART C2;
 STAMP C1;
 TITLE "P1 MUSLO - I-MR Produccion diaria (kg)".

